// Prisma schema for "Precisa-se" (Casa da Cidade Community Platform).
//
// This is the data-layer implementation of docs/ARCHITECTURE.md §5 (data
// model). Field names, types, constraints, and indexes follow that document
// exactly — see §5.1 (entities), §5.2 (relationships), §5.3 (Post state
// machine), and §7 (security: argon2id hashing, app-layer encryption of
// Post.contact_value).
//
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, citext, pg_trgm]
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

/// User.role — RBAC roles for human accounts (§4.4, §7.2).
enum Role {
  user
  moderator
  admin

  @@map("role")
}

/// ApiKey.role — machine clients are always `service` (§4.4, §4.9).
enum ApiKeyRole {
  service

  @@map("api_key_role")
}

/// Post.type — a need ("request") or something offered ("offer").
enum PostType {
  request
  offer

  @@map("post_type")
}

/// Post.status — the Post state machine (§5.3).
enum PostStatus {
  pending
  active
  closed
  rejected

  @@map("post_status")
}

/// Post.contact_method — how the author prefers to be reached off-platform.
enum ContactMethod {
  phone
  whatsapp
  email

  @@map("contact_method")
}

/// ModerationAction.action — moderator decisions (§5.1, Q14: `remove` is a
/// distinct action from `reject` for audit clarity).
enum ModerationActionType {
  approve
  reject
  remove

  @@map("moderation_action_type")
}

/// ConsentRecord.scope — GDPR/LGPD consent scopes (§7.5, BR06).
enum ConsentScope {
  terms
  privacy
  marketing

  @@map("consent_scope")
}

/// Notification.type — the event that generated the notification (§6.1–6.3).
enum NotificationType {
  interest_received
  post_approved
  post_rejected
  post_closed
  password_reset

  @@map("notification_type")
}

/// Notification.channel — WhatsApp is link-out only, never a Notification
/// channel in the MVP (§4.5, §5.1).
enum NotificationChannel {
  email
  in_app

  @@map("notification_channel")
}

/// Notification.status — delivery lifecycle for the worker process (§3.1).
enum NotificationStatus {
  queued
  sent
  failed

  @@map("notification_status")
}

// ---------------------------------------------------------------------
// Entities (§5.1)
// ---------------------------------------------------------------------

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique @db.Citext
  passwordHash      String    @map("password_hash")
  displayName       String    @map("display_name")
  phoneE164         String?   @map("phone_e164")
  /// Optional community/church affiliation (FR13 — "Name, contact info,
  /// optional community/church affiliation"). Free-text, not a FK to any
  /// congregation table — the MVP has no multi-church model.
  churchAffiliation String?   @map("church_affiliation")
  role              Role      @default(user)
  /// UI translation catalog the user prefers (`pt-PT`, `en`, `pt-BR`).
  /// Independent of `country`/`timeZone`/`currency` — a Brazilian expat in
  /// Lisbon may want `pt-BR` UI with `PT` region defaults. Renamed from
  /// `locale` in the 2026-07-18 i18n-beyond-language migration; the URL
  /// segment keeps its single-locale form.
  uiLocale          String    @default("pt-PT") @map("ui_locale")
  /// ISO 3166-1 alpha-2 country code (`PT`, `BR`, `US`, …). Drives
  /// currency/phone-country-code/address-format defaults. Nullable until
  /// the user picks one or it's derived from `uiLocale`'s region subtag.
  country           String?   @db.Char(2)
  /// IANA time zone identifier (`Europe/Lisbon`, `America/Sao_Paulo`, …).
  /// Drives date/time display in shop window, post detail, moderation
  /// queue, and notification emails. Nullable; falls back to the URL
  /// locale's default time zone at render time.
  timeZone          String?   @map("time_zone")
  /// ISO 4217 alpha-3 currency code (`EUR`, `BRL`, `USD`, …). Derived from
  /// `country` by default; user-overridable. Unused in MVP (BR07 — no
  /// payments); reserved for phase-2 job posts.
  currency          String?   @db.Char(3)
  /// `metric` or `us`. Null means "derive from `country`". Unused in MVP
  /// (no structured quantity fields); reserved for future donation-quantity
  /// features.
  measurementSystem String?   @map("measurement_system")
  consentAt         DateTime? @map("consent_at") @db.Timestamptz()
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz()
  /// Set by the Resend webhook (T21) on `email.bounced` events; read by
  /// `ResendMailer.send` (T22) to short-circuit sends before hitting the API.
  emailBouncedAt    DateTime? @map("email_bounced_at") @db.Timestamptz()
  /// Set by the Resend webhook (T21) on `email.complained` events (e.g.
  /// recipient clicked "spam" in their inbox). Suppression-flag semantics
  /// mirror `emailBouncedAt` — once set, the address is never re-tried.
  emailComplainedAt DateTime? @map("email_complained_at") @db.Timestamptz()
  /// Base64-encoded libsodium crypto_secretbox ciphertext of the user's TOTP
  /// secret. Null when MFA is not enabled (opt-in). Application layer only —
  /// Prisma treats this as opaque text.
  mfaSecret         String?   @map("mfa_secret")
  mfaEnabledAt      DateTime? @map("mfa_enabled_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  posts               Post[]               @relation("PostAuthor")
  interests           Interest[]
  moderationActions   ModerationAction[]
  consentRecords      ConsentRecord[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  apiKeysCreated      ApiKey[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// One-time password-reset tokens (forgot-password flow). Tokens are stored
/// hashed (never plaintext) and expire; `usedAt` prevents replay.
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  hashedToken String    @unique @map("hashed_token")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz()
  usedAt      DateTime? @map("used_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Category {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug     String  @unique
  key      String
  isActive Boolean @default(true) @map("is_active")

  posts Post[]

  @@map("categories")
}

model Post {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId        String                   @map("author_id") @db.Uuid
  categoryId      String                   @map("category_id") @db.Uuid
  type            PostType
  status          PostStatus               @default(pending)
  title           String
  description     String
  contactMethod   ContactMethod            @map("contact_method")
  /// Encrypted at the application layer (libsodium crypto_secretbox, §7.4).
  /// Never store or read plaintext contact info through Prisma directly.
  contactValue    Bytes                    @map("contact_value")
  locale          String
  extraAttributes Json                     @default("{}") @map("extra_attributes")
  publishedAt     DateTime?                @map("published_at") @db.Timestamptz()
  closedAt        DateTime?                @map("closed_at") @db.Timestamptz()
  rejectedReason  String?                  @map("rejected_reason")
  /// Generated column (`to_tsvector(locale, title || ' ' || description)`) —
  /// created via raw SQL in the migration, not managed by Prisma Client.
  searchVector    Unsupported("tsvector")? @map("search_vector")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz()

  author            User               @relation("PostAuthor", fields: [authorId], references: [id])
  category          Category           @relation(fields: [categoryId], references: [id])
  interests         Interest[]
  moderationActions ModerationAction[]
  notifications     Notification[]

  // Shop-window listing filter (§5.1).
  @@index([status, categoryId, type])
  // My-posts view (`listByAuthor`) filters on authorId; createdAt backs
  // the `orderBy desc` in the same query — combined index serves both.
  @@index([authorId, createdAt])
  // Full-text search (GIN on search_vector) and the pg_trgm trigram index
  // over (title, description) for keyword search (§5.1, FR07) are created
  // via raw SQL in the migration, alongside the generated `search_vector`
  // column — Prisma does not support generated columns or trigram operator
  // classes declaratively.
  @@map("posts")
}

model Interest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  message   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  // One interest per user per post (§5.1).
  @@unique([postId, userId])
  // GDPR/LGPD account deletion deletes all of a user's Interest rows by
  // `userId` — the composite PK above is `(postId, userId)` and doesn't
  // help a `WHERE user_id = ?` lookup, so without this index that delete
  // is a seq scan over an unbounded table.
  @@index([userId])
  @@map("interests")
}

model ModerationAction {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId      String               @map("post_id") @db.Uuid
  moderatorId String               @map("moderator_id") @db.Uuid
  action      ModerationActionType
  /// Required on `reject` — enforced in the service layer, not the DB.
  reason      String?
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz()

  post      Post @relation(fields: [postId], references: [id])
  moderator User @relation(fields: [moderatorId], references: [id])

  @@map("moderation_actions")
}

model ConsentRecord {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  scope       ConsentScope
  version     String
  grantedAt   DateTime     @map("granted_at") @db.Timestamptz()
  withdrawnAt DateTime?    @map("withdrawn_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  // Account-deletion bulk-withdraw (`updateMany WHERE userId AND withdrawnAt IS NULL`)
  // — without this index that's a seq scan over every consent row for every
  // user every time anyone self-deletes.
  @@index([userId, withdrawnAt])
  @@map("consent_records")
}

model Notification {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String              @map("recipient_id") @db.Uuid
  postId      String?             @map("post_id") @db.Uuid
  type        NotificationType
  payload     Json
  channel     NotificationChannel
  status      NotificationStatus  @default(queued)
  attempts    Int                 @default(0)
  lastError   String?             @map("last_error")
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz()
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  recipient User  @relation(fields: [recipientId], references: [id])
  post      Post? @relation(fields: [postId], references: [id])

  @@index([status, channel, createdAt])
  @@map("notifications")
}

model AuditLog {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId       String?              @map("actor_id") @db.Uuid
  actorApiKeyId String?              @map("actor_api_key_id") @db.Uuid
  action        String
  targetType    String               @map("target_type")
  targetId      String?              @map("target_id") @db.Uuid
  before        Json?
  after         Json?
  /// Postgres native `inet` type — Prisma has no first-class mapping.
  ip            Unsupported("inet")?
  userAgent     String?              @map("user_agent")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz()

  actor  User?   @relation(fields: [actorId], references: [id])
  apiKey ApiKey? @relation(fields: [actorApiKeyId], references: [id])

  // Audit review queries typically filter by `actorId` over a 12-month
  // retention window (§7.6, Q8) — without this index those queries are a
  // seq scan over a fast-growing table.
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model ApiKey {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  /// argon2id hash of the bearer token; raw token shown once at creation.
  hashedToken String     @unique @map("hashed_token")
  prefix      String
  role        ApiKeyRole @default(service)
  scopes      String[]   @default([])
  createdById String     @map("created_by") @db.Uuid
  lastUsedAt  DateTime?  @map("last_used_at") @db.Timestamptz()
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz()
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  createdBy User       @relation(fields: [createdById], references: [id])
  auditLogs AuditLog[]

  @@map("api_keys")
}

model SiteConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("site_configs")
}
