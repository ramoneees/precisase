# Precisa-se — environment variables (ARCHITECTURE.md §4.4, §7.4, §8).
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# only this `.env.example` (with placeholders) is committed.
#
# Used by: docker-compose.yml (base), docker-compose.staging.yml,
# docker-compose.prod.yml.

# -----------------------------------------------------------------------
# App / runtime
# -----------------------------------------------------------------------
# Standard Next.js environment. Compose sets NODE_ENV=production directly
# for the `web`/`worker` services; this is a fallback for local (non-Docker)
# runs.
NODE_ENV=development

# Public base URL the app is served at (used for absolute links in emails,
# Auth.js callback URLs, etc.). Domain strategy is still open — ARCH §12 Q12.
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------
# Database (§4.3) — PostgreSQL 16, self-hosted in the `db` Compose service.
# -----------------------------------------------------------------------
POSTGRES_USER=precisase
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=precisase

# Full connection string consumed by Prisma. Host is the Compose service
# name `db` (internal network only, §7.3), not localhost.
DATABASE_URL=postgresql://precisase:change-me-postgres-password@db:5432/precisase?schema=public

# -----------------------------------------------------------------------
# Redis (§4.7/§8.1) — OPTIONAL. Only needed if/when session storage or a
# queue backend move off Postgres. The `redis` Compose service is defined
# behind the `optional` profile and is not started by default.
# -----------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------
# Auth.js / NextAuth v5 (§4.4)
# -----------------------------------------------------------------------
# Secret used to sign session cookies/JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-base64-secret
# Must match APP_URL in production; required by Auth.js v5.
AUTH_URL=http://localhost:3000
# Set to "true" when running behind a reverse proxy (Caddy/Cloudflare
# Tunnel) so Auth.js trusts the forwarded host/proto headers.
AUTH_TRUST_HOST=true

# -----------------------------------------------------------------------
# PII encryption (§7.4) — Post.contact_value is encrypted at the app layer
# with libsodium crypto_secretbox before it is written to Postgres, so a DB
# dump alone never leaks contact details.
# -----------------------------------------------------------------------
# 32-byte key, base64-encoded. Generate with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTACT_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# -----------------------------------------------------------------------
# Transactional email (§4.5) — Resend (recommended, ARCH Q5).
# -----------------------------------------------------------------------
RESEND_API_KEY=re_replace_with_real_key
# "From" address used for notification emails.
RESEND_FROM_EMAIL=notificacoes@casadacidade.example

# -----------------------------------------------------------------------
# Observability (§4.8/§9) — Sentry, optional but recommended.
# -----------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------
# Reverse proxy (Caddyfile) — §4.7
# -----------------------------------------------------------------------
# Site address Caddy listens/serves on. Local/dev: ":80". Staging/prod:
# the real hostname (Caddy then auto-provisions TLS as a fallback path —
# see §4.7/§13 — in case the Cloudflare Tunnel path is ever bypassed).
CADDY_SITE_ADDRESS=:80

# -----------------------------------------------------------------------
# Cloudflare Tunnel (§4.7, §7.3) — egress-only, no inbound host ports.
# -----------------------------------------------------------------------
# Tunnel token from the Cloudflare Zero Trust dashboard (Tunnels > your
# tunnel > "Install and run a connector"). Treat as a secret.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-real-cloudflare-tunnel-token

# -----------------------------------------------------------------------
# Backups (§8.3) — daily pg_dump at 02:00, retention defaults pending
# church-IT confirmation (Open question Q10).
# -----------------------------------------------------------------------
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12

# -----------------------------------------------------------------------
# Staging-only overrides (§8.2) — used by docker-compose.staging.yml.
# Not needed for base/prod.
# -----------------------------------------------------------------------
STAGING_APP_URL=https://staging.precisase.example
# Separate Cloudflare Tunnel from prod, per §8.2 ("staging Cloudflare
# Tunnel hostname").
CLOUDFLARE_TUNNEL_TOKEN_STAGING=replace-with-staging-cloudflare-tunnel-token
